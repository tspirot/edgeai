{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "web:dev",
      "type": "npm",
      "script": "dev",
      "path": "web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*(ready in|Local:).*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "web" }
    },
    {
      "label": "web:build",
      "type": "npm",
      "script": "build",
      "path": "web",
      "problemMatcher": []
    },
    {
      "label": "web:preview",
      "type": "npm",
      "script": "preview",
      "path": "web",
      "problemMatcher": []
    },
    {
      "label": "titlovi:install",
      "type": "shell",
      "command": "python -m pip install -e .",
      "options": { "cwd": "${workspaceFolder}/projekti/titlovi-uzivo" },
      "problemMatcher": []
    },
    {
      "label": "titlovi:test",
      "type": "shell",
      "command": "python -m pytest -v",
      "options": { "cwd": "${workspaceFolder}/projekti/titlovi-uzivo" },
      "problemMatcher": []
    }
  ]
}
