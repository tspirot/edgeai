{
  "python.defaultInterpreterPath": "${workspaceFolder}/projekti/titlovi-uzivo/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["projekti/titlovi-uzivo", "projekti/pametna-zebra"],
  "python.analysis.extraPaths": [
    "projekti/titlovi-uzivo/src",
    "projekti/pametna-zebra/src"
  ],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.venv": true
  }
}
